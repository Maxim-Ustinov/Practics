{
  "$name": "TenderScope Design Tokens",
  "$version": "1.0.0",
  "$description": "Единые токены бренда TenderScope. Значения цветов совпадают с tender_ai/lib/core/theme/app_palette.dart",
  "color": {
    "brand": {
      "graphite": "#1F1F1F",
      "signal-blue": "#4F7CFF",
      "check-gold": "#FFB547",
      "paper": "#F5F5F7"
    },
    "dark": {
      "bg": "#1F1F1F",
      "surface": "#262626",
      "surface2": "#2E2E2E",
      "border": "#333333",
      "borderSoft": "#2A2A2A",
      "ink": "#F5F5F7",
      "inkDim": "#9A9A9F",
      "inkMute": "#6F6F74",
      "accent": "#4F7CFF",
      "accent2": "#7BA0FF",
      "gold": "#FFB547",
      "green": "#3CCB7F",
      "orange": "#FFA640",
      "red": "#FF6B6B"
    },
    "light": {
      "bg": "#F7F8FA",
      "surface": "#FFFFFF",
      "surface2": "#F1F2F5",
      "border": "#E3E5EA",
      "borderSoft": "#EEF0F4",
      "ink": "#1A1B1F",
      "inkDim": "#5C5F66",
      "inkMute": "#8B8E96",
      "accent": "#3E68FF",
      "accent2": "#6587FF",
      "gold": "#E8A53C",
      "green": "#1FA877",
      "orange": "#E08A2B",
      "red": "#E53E5B"
    },
    "semantic": {
      "success": "#3CCB7F",
      "warning": "#FFA640",
      "danger": "#FF6B6B",
      "focus-ring": "rgba(79, 124, 255, 0.35)",
      "overlay": "rgba(0, 0, 0, 0.55)"
    },
    "gradient": {
      "cta": ["#5A86FF", "#4F7CFF"],
      "splash-glow": ["rgba(79, 124, 255, 0.14)", "rgba(31, 31, 31, 0)"]
    }
  },
  "typography": {
    "family": "Manrope",
    "fallback": "\"Segoe UI\", Roboto, Arial, sans-serif",
    "stack": "Manrope, \"Segoe UI\", Roboto, Arial, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "display": { "sizePx": 32, "sizePt": 22, "lineHeight": 1.15, "letterSpacingPx": -0.5, "weight": 800 },
      "h1": { "sizePx": 24, "sizePt": 18, "lineHeight": 1.2, "letterSpacingPx": -0.3, "weight": 800 },
      "h2": { "sizePx": 20, "sizePt": 14, "lineHeight": 1.25, "letterSpacingPx": -0.2, "weight": 700 },
      "h3": { "sizePx": 17, "sizePt": 12, "lineHeight": 1.3, "letterSpacingPx": -0.1, "weight": 700 },
      "bodyL": { "sizePx": 16, "sizePt": 10, "lineHeight": 1.5, "letterSpacingPx": 0, "weight": 500 },
      "body": { "sizePx": 15, "sizePt": 9, "lineHeight": 1.47, "letterSpacingPx": 0, "weight": 500 },
      "caption": { "sizePx": 12, "sizePt": 7.5, "lineHeight": 1.33, "letterSpacingPx": 0.2, "weight": 500 },
      "overline": { "sizePx": 11, "sizePt": 6.5, "lineHeight": 1.27, "letterSpacingPx": 1.2, "weight": 700, "transform": "uppercase" }
    }
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 14,
    "xl": 20,
    "2xl": 28,
    "pill": 999
  },
  "shadow": {
    "card": "0 8px 24px rgba(0, 0, 0, 0.35)",
    "cardLight": "0 8px 24px rgba(26, 27, 31, 0.08)",
    "cta": "0 8px 20px rgba(79, 124, 255, 0.35)",
    "focus": "0 0 0 4px rgba(79, 124, 255, 0.18)",
    "gold": "0 8px 20px rgba(255, 181, 71, 0.25)"
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64
  },
  "layout": {
    "screenPadding": 20,
    "cardPadding": 16,
    "sectionGap": 32,
    "minTouchTarget": 44,
    "maxContentWidth": 1200
  },
  "border": {
    "width": {
      "hairline": 1,
      "input": 1.5,
      "focus": 1.5,
      "icon": 2
    }
  },
  "logo": {
    "viewBox": "0 0 200 200",
    "lens": { "cx": 85, "cy": 85, "r": 55, "stroke": 11 },
    "handle": { "from": [127, 127], "to": [169, 169], "stroke": 20 },
    "check": { "points": [[60, 90], [80, 108], [115, 68]], "stroke": 12 },
    "opticalOffset": -2,
    "clearSpaceRatio": 0.25,
    "minSizePx": { "icon": 24, "lockup": 120 },
    "minSizeMm": { "icon": 10, "lockup": 30 }
  },
  "icon": {
    "background": "#1F1F1F",
    "glow": "rgba(79, 124, 255, 0.30)",
    "markScale": 0.78,
    "safeZone": 0.66,
    "exports": [1024, 512, 192, 48],
    "faviconRadius": 0.22
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 240, "splash": 2400 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasis": "cubic-bezier(0.34, 1.56, 0.64, 1)" }
  },
  "voice": {
    "language": "ru",
    "address": "вы",
    "productName": "TenderScope",
    "tagline": "Умный поиск закупок для бизнеса",
    "proPrice": "999 ₽/мес",
    "bannedWords": ["реальное время", "гарантия победы", "самый", "единственный", "в 10 раз"]
  }
}
